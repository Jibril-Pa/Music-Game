# Copy this file to backend/.env and fill it in. Both services are optional:
# without them the game plays the same, and the lute gives its built-in tips.

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The Gemini model that writes the lute's advice (any Gemini text model).
GEMINI_MODEL=gemini-3.8-flash

# Tiger Data service URL (Tiger Cloud console > your service > connection info,
# or the config file you downloaded when you created the service):
#   postgresql://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Extra origins allowed to call this API (comma-separated), e.g. a deployed frontend.
# localhost:3000 and https://thetravelinglute.tech are always allowed.
# GS_CORS_ORIGINS=https://staging.thetravelinglute.tech
